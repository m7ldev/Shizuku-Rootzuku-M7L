<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="startup"
        android:title="@string/settings_startup">

        <rikka.material.preference.MaterialSwitchPreference
            android:key="start_on_boot"
            android:summary="@string/settings_start_on_boot_summary"
            android:title="@string/settings_start_on_boot" />

        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="false"
            android:key="disable_wadb_after_start"
            android:summary="@string/settings_disable_wadb_summary"
            android:title="@string/settings_disable_wadb" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="monitor"
        android:title="@string/settings_monitor">

        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="false"
            android:key="status_notification"
            android:summary="@string/settings_status_notification_summary"
            android:title="@string/settings_status_notification" />

        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="false"
            android:dependency="status_notification"
            android:key="watchdog"
            android:summary="@string/settings_watchdog_summary"
            android:title="@string/settings_watchdog" />

        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="false"
            android:dependency="status_notification"
            android:key="alert_on_use"
            android:summary="@string/settings_alert_on_use_summary"
            android:title="@string/settings_alert_on_use" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="security"
        android:title="@string/settings_security">

        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="false"
            android:key="app_lock"
            android:summary="@string/settings_app_lock_summary"
            android:title="@string/settings_app_lock" />

        <Preference
            android:key="auto_revoke"
            android:summary="@string/settings_auto_revoke_summary"
            android:title="@string/settings_auto_revoke" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_language">

        <rikka.preference.SimpleMenuPreference
            android:defaultValue="SYSTEM"
            android:key="language"
            android:summary="%s"
            android:title="@string/settings_language" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="user_interface"
        android:title="@string/settings_user_interface">

        <moe.shizuku.manager.settings.IntegerSimpleMenuPreference
            android:entries="@array/night_mode"
            android:entryValues="@array/night_mode_value"
            android:key="night_mode"
            android:summary="%s"
            android:title="@string/dark_theme" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="black_night_theme"
            android:summary="@string/settings_black_night_theme_summary"
            android:title="@string/settings_black_night_theme" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="use_system_color"
            android:title="@string/settings_use_system_color" />

    </PreferenceCategory>

</PreferenceScreen>
