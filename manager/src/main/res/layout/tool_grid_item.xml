<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp"
    android:stateListAnimator="@animator/press_scale"
    tools:background="@drawable/neon_card_teal">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:importantForAccessibility="no"
        tools:background="@drawable/tool_icon_teal"
        tools:src="@drawable/ic_folder_24" />

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/neon_text"
        android:textSize="14sp"
        tools:text="File manager" />

</LinearLayout>
