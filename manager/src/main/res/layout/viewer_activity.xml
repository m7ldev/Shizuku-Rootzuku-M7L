<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="?actionBarSize"
    app:fitsSystemWindowsInsets="bottom|top">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/text_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <EditText
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:padding="12dp"
                android:textColor="@color/neon_text"
                android:textDirection="ltr"
                android:textSize="12sp" />

        </ScrollView>

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <VideoView
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/tools_loading"
            android:textColor="@color/neon_text_secondary" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:background="@drawable/neon_row_background"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/find_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/neon_text_secondary"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/find_case"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/viewer_find_case"
                android:textColor="@color/neon_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <EditText
            android:id="@+id/find_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/viewer_find"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:singleLine="true"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/replace_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/viewer_replace_with"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:singleLine="true"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/find_prev"
                style="@style/FindButton"
                android:text="@string/viewer_find_prev" />

            <TextView
                android:id="@+id/find_next"
                style="@style/FindButton"
                android:text="@string/viewer_find_next" />

            <TextView
                android:id="@+id/find_replace"
                style="@style/FindButton"
                android:text="@string/viewer_replace" />

            <TextView
                android:id="@+id/find_replace_all"
                style="@style/FindButton"
                android:text="@string/viewer_replace_all" />

            <TextView
                android:id="@+id/find_close"
                style="@style/FindButton"
                android:text="×"
                android:textSize="20sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
